# Server Environment Variables
# Copy this file to .env and fill in the values

# ---------------------------------
# Server Config
# ---------------------------------
PORT=5000
NODE_ENV=development

# ---------------------------------
# PostgreSQL Database
# ---------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/medical_website?schema=public"

# ---------------------------------
# JWT Authentication
# ---------------------------------
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ---------------------------------
# Brevo (SendInBlue) Email Service
# ---------------------------------
BREVO_API_KEY=your_brevo_api_key_here

# Sender email and display name for outgoing emails
EMAIL_FROM=noreply@medportal.com
EMAIL_FROM_NAME=MedPortal

# ---------------------------------
# App URLs
# ---------------------------------
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ---------------------------------
# Orders
# ---------------------------------
# Where contact-form messages are sent (the shop owner's email)
ADMIN_EMAIL=
# Where new-order alerts are sent (leave empty to use ADMIN_EMAIL)
ORDER_NOTIFY_EMAIL=
# Shown to customers who choose "Bank transfer"
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_IBAN=
