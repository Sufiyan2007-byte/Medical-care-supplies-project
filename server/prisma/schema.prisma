// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for medical website
model User {
  id            Int          @id @default(autoincrement())
  name          String
  email         String       @unique
  password_hash String       @map("password_hash")
  is_verified   Boolean      @default(false) @map("is_verified")
  role          String       @default("user")
  created_at    DateTime     @default(now()) @map("created_at")
  email_tokens  EmailToken[]
  orders        Order[]
  phone         String?
  city          String?
  address       String?

  @@map("users")
}

// Email tokens model for verification & password resets
model EmailToken {
  id         Int       @id @default(autoincrement())
  user_id    Int       @map("user_id")
  token      String
  type       String    // 'verify' or 'reset'
  expires_at DateTime  @map("expires_at")
  used_at    DateTime? @map("used_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_tokens")
}

// Revoked JWT tokens blocklist for logout / token invalidation
model RevokedToken {
  id         Int      @id @default(autoincrement())
  jti        String   @unique // JWT ID claim
  user_id    Int      @map("user_id")
  expires_at DateTime @map("expires_at") // mirrors JWT exp so we can prune stale rows
  revoked_at DateTime @default(now()) @map("revoked_at")

  @@index([jti])
  @@map("revoked_tokens")
}

// Product Categories (Surgical Instruments, Medical Consumables, Surgical Sets)
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  products    Product[]

  @@map("categories")
}

// Product items & sets catalog
model Product {
  id           Int           @id @default(autoincrement())
  category_id  Int           @map("category_id")
  name         String
  description  String?
  sku          String?       @unique
  price        Decimal?      @db.Decimal(10, 2) // SAR, excluding VAT. null = "price on request"
  stock        Int?          // null = stock not tracked
  image        String?
  category     Category      @relation(fields: [category_id], references: [id])
  set_items    ProductItem[] @relation("SetToItem")
  part_of_sets ProductItem[] @relation("ItemToSet")
  surgical_set SurgicalSet?

  @@map("products")
}

// Surgical set specifications
model SurgicalSet {
  id            Int     @id @default(autoincrement())
  product_id    Int     @unique @map("product_id")
  name          String
  piece_count   Int     @map("piece_count")
  description   String?
  material      String?
  finish        String?
  sterilization String?
  standard      String?
  tray_case     String? @map("tray_case")

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("surgical_sets")
}

// Set content items with quantity
model ProductItem {
  id         Int @id @default(autoincrement())
  set_id     Int @map("set_id")
  product_id Int @map("product_id")
  quantity   Int @default(1)

  set     Product @relation("SetToItem", fields: [set_id], references: [id], onDelete: Cascade)
  product Product @relation("ItemToSet", fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_items")
}

// Company profile & information
model CompanyInfo {
  id         Int      @id @default(autoincrement())
  about_text String?
  vision     String?
  mission    String?
  cr_number      String?  @map("cr_number")
  vat_number     String?  @map("vat_number")
  entity_type    String?  @map("entity_type")
  certifications String?
  address    String?
  email      String?
  phone      String?
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@map("company_info")
}

// Contact form messages
model ContactMessage {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  message    String
  created_at DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

// Customer orders (cash on delivery or bank transfer)
model Order {
  id             Int         @id @default(autoincrement())
  order_number   String      @unique @map("order_number")
  user_id        Int?        @map("user_id") // null for guest checkout
  customer_name  String      @map("customer_name")
  customer_email String      @map("customer_email")
  customer_phone String      @map("customer_phone")
  city           String
  address        String
  notes          String?
  payment_method String      @map("payment_method") // 'cod' | 'bank_transfer'
  status         String      @default("pending") // pending | confirmed | shipped | delivered | cancelled
  subtotal       Decimal?    @db.Decimal(12, 2) // sum of priced lines only
  vat            Decimal?    @db.Decimal(12, 2)
  total          Decimal?    @db.Decimal(12, 2)
  needs_quote    Boolean     @default(false) @map("needs_quote") // true when any line has no price yet
  lang           String      @default("ar")
  created_at     DateTime    @default(now()) @map("created_at")
  updated_at     DateTime    @updatedAt @map("updated_at")

  user  User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([user_id])
  @@index([customer_email])
  @@map("orders")
}

// Snapshot of each ordered line (name/sku/price are copied so later catalog edits don't change history)
model OrderItem {
  id         Int      @id @default(autoincrement())
  order_id   Int      @map("order_id")
  product_id Int?     @map("product_id")
  sku        String?
  name       String
  quantity   Int
  unit_price Decimal? @db.Decimal(10, 2)
  line_total Decimal? @db.Decimal(12, 2)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@map("order_items")
}
