{
  "name": "medical-website-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.2.5"
  },
  "description": "Welcome to the Medical Website codebase. This repository is structured as a monorepo containing both the frontend client and the backend server.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sufiyan2007-byte/Medical-care-supplies-project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Sufiyan2007-byte/Medical-care-supplies-project/issues"
  },
  "homepage": "https://github.com/Sufiyan2007-byte/Medical-care-supplies-project#readme"
}
