<file path="client/src/components/AdminRoute.jsx">
import { Navigate } from 'react-router-dom';
import { useAuth } from '../hooks/useAuth';

const AdminRoute = ({ children }) => {
  const { user, loading } = useAuth();

  if (loading) {
    return <div>Loading admin dashboard...</div>;
  }

  if (!user || user.role !== 'admin') {
    return <Navigate to="/" replace />;
  }

  return children;
};

export default AdminRoute;
</file>

<file path="client/src/components/CartPanel.css">
.cart-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  justify-content: flex-end;
}

.cart-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.4);
  backdrop-filter: blur(4px);
}

.cart-panel {
  position: relative;
  width: 100%;
  max-width: 400px;
  background: #ffffff;
  height: 100%;
  display: flex;
  flex-direction: column;
  box-shadow: -8px 0 32px rgba(0, 0, 0, 0.1);
  animation: slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.cart-panel--rtl {
  animation: slideInLeft 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}

@keyframes slideInLeft {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}

.cart-header {
  padding: 1.5rem;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-header h2 {
  margin: 0;
  font-size: 1.25rem;
  font-weight: 700;
  color: #0f172a;
}

.cart-close-btn {
  background: none;
  border: none;
  color: #64748b;
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.cart-close-btn:hover {
  background: #f1f5f9;
  color: #0f172a;
}

.cart-content {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
}

.cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #64748b;
  text-align: center;
  gap: 1rem;
}

.cart-items {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  padding-bottom: 1rem;
  border-bottom: 1px solid #e2e8f0;
}

.cart-item-info h4 {
  margin: 0 0 0.25rem;
  font-size: 1rem;
  font-weight: 600;
  color: #1e293b;
}

.cart-item-price {
  margin: 0;
  font-size: 0.9rem;
  font-weight: 500;
  color: #FF6600;
}

.cart-item-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.cart-qty-ctrl {
  display: flex;
  align-items: center;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  overflow: hidden;
}

.cart-qty-ctrl button {
  background: #f8fafc;
  border: none;
  width: 28px;
  height: 28px;
  font-size: 1.1rem;
  cursor: pointer;
  color: #475569;
  transition: background 0.2s;
}

.cart-qty-ctrl button:hover {
  background: #e2e8f0;
}

.cart-qty-ctrl span {
  width: 32px;
  text-align: center;
  font-size: 0.95rem;
  font-weight: 500;
  color: #0f172a;
}

.cart-item-remove {
  background: none;
  border: none;
  color: #ef4444;
  cursor: pointer;
  padding: 0.4rem;
  border-radius: 6px;
  transition: background 0.2s;
}

.cart-item-remove:hover {
  background: #fef2f2;
}

.cart-footer {
  padding: 1.5rem;
  border-top: 1px solid #e2e8f0;
  background: #f8fafc;
}

.cart-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  font-size: 1.1rem;
  font-weight: 600;
  color: #0f172a;
}

.cart-total-price {
  font-size: 1.3rem;
  color: #FF6600;
}

.cart-btn {
  width: 100%;
  padding: 0.85rem;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: all 0.2s;
}

.cart-btn--primary {
  background: #FF6600;
  color: #fff;
}

.cart-btn--primary:hover {
  background: #E65C00;
}

.cart-btn--secondary {
  background: #e2e8f0;
  color: #334155;
  margin-top: 1rem;
}

.cart-btn--secondary:hover {
  background: #cbd5e1;
}

/* Dark Mode */
