                  >
                    {t('cart.add', 'Add')}
                  </button>
                </div>
              </div>
            </Link>
          ))}
        </div>
      </section>

      {/* ── Trust Badges ────────────────────────────────────── */}
      <section className="trust-section">
        <div className="trust-inner">
          {TRUST.map((item, i) => (
            <div key={i} className="trust-card">
              <div className="trust-icon-wrap">
                <item.Icon />
              </div>
              <h4>{t(item.titleKey)}</h4>
              <p>{t(item.textKey)}</p>
            </div>
          ))}
        </div>
      </section>

    </div>
  );
}

export default Home;
