  to   { opacity: 1; transform: translateY(0); }
}

/* ── Header ─────────────────────────────────────────────────────────────── */

.products-header {
  text-align: center;
  margin-bottom: 4.5rem;
}

.products-header h1 {
  font-size: 3rem;
  font-weight: 800;
  letter-spacing: -0.5px;
  background: linear-gradient(135deg, #E65C00, #FF6600);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 1rem;
}

.products-header p {
  font-size: 1.2rem;
  color: #64748b;
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.7;
}

/* ── Cards Grid ──────────────────────────────────────────────────────────── */

.category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2rem;
}

/* ── Category Card ───────────────────────────────────────────────────────── */

.category-card {
  position: relative;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  padding: 0;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
  display: flex;
  flex-direction: column;
  gap: 0;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
}

.category-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 24px 56px rgba(0, 0, 0, 0.14);
}

/* Hero image at top of card */
.cat-hero-img {
  position: relative;
  width: 100%;
  height: 220px;
  background-size: cover;
  background-position: center;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: height 0.3s ease;
}

.category-card:hover .cat-hero-img {
  height: 230px;
}

.cat-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(6,22,58,0.45) 0%, rgba(6,22,58,0.7) 100%);
  transition: opacity 0.3s ease;
}

.category-card:hover .cat-hero-overlay {
  opacity: 0.85;
}

.cat-hero-icon {
  width: 64px;
  height: 64px;
  object-fit: contain;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));
  transition: transform 0.35s ease;
}

.category-card:hover .cat-hero-icon {
  transform: scale(1.12);
}

/* ── Card Parts ──────────────────────────────────────────────────────────── */

.card-body {
  flex: 1;
  padding: 1.5rem 1.5rem 0.5rem;
}

.card-body h2 {
  font-size: 1.5rem;
  font-weight: 700;
  color: #0f172a;
  margin: 0 0 0.6rem;
}

.card-body p {
  font-size: 1rem;
  color: #475569;
  line-height: 1.65;
  margin: 0;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1.5rem 1.5rem;
}

.product-count {
  font-size: 0.85rem;
  font-weight: 600;
  color: #94a3b8;
  background: rgba(148, 163, 184, 0.12);
  padding: 0.3rem 0.75rem;
  border-radius: 999px;
}

.browse-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.95rem;
  font-weight: 600;
  color: #FF6600;
  background: rgba(255, 102, 0, 0.08);
  border: none;
  padding: 0.5rem 1.1rem;
  border-radius: 10px;
  cursor: pointer;
  transition: background 0.2s, gap 0.2s;
  text-decoration: none;
}

.browse-btn:hover {
  background: rgba(255, 102, 0, 0.16);
  gap: 0.65rem;
}

/* ── Loading / Error ─────────────────────────────────────────────────────── */

.products-status {
  text-align: center;
  padding: 4rem 2rem;
  color: #94a3b8;
  font-size: 1.1rem;
}

.products-status h2 {
  color: #ef4444;
  margin-bottom: 0.5rem;
}

/* ── Dark Mode ───────────────────────────────────────────────────────────── */

@media (prefers-color-scheme: dark) {
  .products-header p {
    color: #94a3b8;
  }

  .category-card {
    background: rgba(30, 41, 59, 0.75);
    border-color: rgba(255, 255, 255, 0.06);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .category-card:hover {
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.55);
  }

  .card-body h2 { color: #f8fafc; }
  .card-body p  { color: #94a3b8; }

  .product-count {
    background: rgba(255, 255, 255, 0.06);
    color: #64748b;
  }

  .browse-btn {
    color: #60a5fa;
    background: rgba(96, 165, 250, 0.1);
  }

  .browse-btn:hover {
    background: rgba(96, 165, 250, 0.18);
  }
}

/* ── Responsive ──────────────────────────────────────────────────────────── */

@media (max-width: 640px) {
  .products-header h1 { font-size: 2.2rem; }
  .category-grid { grid-template-columns: 1fr; }
}
