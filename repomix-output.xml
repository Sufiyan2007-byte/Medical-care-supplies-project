<file path="client/src/pages/Home.css">
/* ─────────────────────────────────────────────
   Home Page — Full redesign with slider, cards & trust
───────────────────────────────────────────── */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

.home-page {
  font-family: 'Inter', 'Tajawal', system-ui, sans-serif;
  overflow-x: hidden;
}

/* ── Hero Slider ─────────────────────────────────────────────── */

.hero-slider {
  position: relative;
  height: 560px;
  overflow: hidden;
  border-radius: 0 0 28px 28px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
}

.hero-slide {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: 0;
  transform: scale(1.04);
  transition: opacity 0.8s ease, transform 1.2s ease;
  will-change: opacity, transform;
}

.hero-slide--active {
  opacity: 1;
  transform: scale(1);
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to right,
    rgba(6, 22, 58, 0.82) 0%,
    rgba(6, 22, 58, 0.55) 50%,
    rgba(6, 22, 58, 0.25) 100%
  );
  z-index: 1;
}

.hero-content {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 3rem 5rem;
  max-width: 680px;
  animation: heroContentIn 0.6s ease both;
}

@keyframes heroContentIn {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.35rem 0.85rem;
  border-radius: 30px;
  letter-spacing: 0.3px;
  margin-bottom: 1.25rem;
  width: fit-content;
}

.hero-title {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
  letter-spacing: -0.5px;
  margin: 0 0 1rem;
  text-shadow: 0 2px 12px rgba(0,0,0,0.3);
}

.hero-subtitle {
  font-size: 1.05rem;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.7;
  margin: 0 0 2rem;
  max-width: 46ch;
}

.hero-cta-group {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.85rem 1.75rem;
  border-radius: 12px;
  font-size: 0.95rem;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.25s ease;
}

.hero-btn--primary {
  background: #FF6600;
  color: #fff;
  box-shadow: 0 8px 24px rgba(255, 102, 0, 0.4);
}
.hero-btn--primary:hover {
  background: #E65C00;
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(255, 102, 0, 0.5);
}

.hero-btn--ghost {
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  border: 1.5px solid rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(6px);
}
.hero-btn--ghost:hover {
  background: rgba(255, 255, 255, 0.25);
  transform: translateY(-2px);
}

/* Arrow buttons */
.hero-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 3;
  background: rgba(255, 255, 255, 0.15);
  border: 1.5px solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(8px);
  color: #fff;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  font-size: 1.6rem;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.hero-arrow:hover {
  background: rgba(255, 255, 255, 0.3);
  transform: translateY(-50%) scale(1.08);
}
.hero-arrow--prev { left: 1.5rem; }
.hero-arrow--next { right: 1.5rem; }

/* Dot indicators */
.hero-dots {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  display: flex;
  gap: 0.5rem;
}

.hero-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  padding: 0;
}
.hero-dot--active {
  width: 28px;
  border-radius: 4px;
  background: #fff;
}

/* ── Stats Bar ───────────────────────────────────────────────── */

.stats-bar {
  display: flex;
  justify-content: center;
  background: linear-gradient(135deg, #062e6f, var(--primary-dark));
  padding: 0;
  flex-wrap: wrap;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.75rem 2.5rem;
  border-right: 1px solid rgba(255, 255, 255, 0.1);
  color: #fff;
  transition: background 0.2s ease;
  flex: 1;
  min-width: 180px;
  max-width: 280px;
}
.stat-item:last-child { border-right: none; }
.stat-item:hover { background: rgba(255,255,255,0.06); }

.stat-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 14px;
  background: rgba(255, 102, 0, 0.15);
  border: 1px solid rgba(255, 102, 0, 0.3);
  color: #FF6600;
  flex-shrink: 0;
  transition: background 0.2s ease;
}
.stat-item:hover .stat-icon-wrap {
  background: rgba(255, 102, 0, 0.28);
}

.stat-val {
  font-size: 1.4rem;
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.5px;
  line-height: 1.2;
}

.stat-label {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.65);
  font-weight: 500;
  margin-top: 0.15rem;
}

/* ── Section Headings ────────────────────────────────────────── */

.home-section-header {
  text-align: center;
  margin-bottom: 2.75rem;
}

.home-section-title {
  font-size: clamp(1.6rem, 3vw, 2.1rem);
  font-weight: 800;
  text-align: center;
  letter-spacing: -0.5px;
  background: linear-gradient(135deg, #E65C00, #FF6600);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin: 0 0 0.75rem;
}

.home-section-sub {
  text-align: center;
  color: #64748b;
  font-size: 0.975rem;
  max-width: 560px;
  margin: 0 auto;
  line-height: 1.75;
}

/* ── Category Cards ──────────────────────────────────────────── */

.home-categories {
  padding: 4rem 2rem;
  max-width: 1200px;
  margin: 0 auto;
}

.home-cat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.75rem;
}

.home-cat-card {
  border-radius: 20px;
  overflow: hidden;
  background: #fff;
  text-decoration: none;
  color: inherit;
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  display: flex;
  flex-direction: column;
  border: 1px solid #f1f5f9;
}
.home-cat-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
}

.home-cat-img {
  position: relative;
  height: 200px;
  background-size: cover;
  background-position: center;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-cat-img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 100%);
  opacity: 0.8;
  transition: opacity 0.3s ease;
}
.home-cat-card:hover .home-cat-img-overlay { opacity: 0.9; }

.home-cat-icon-img {
  width: 72px;
  height: 72px;
  object-fit: contain;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3));
  transition: transform 0.3s ease;
}
.home-cat-card:hover .home-cat-icon-img {
  transform: scale(1.1);
}

.home-cat-body {
  padding: 1.5rem;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.home-cat-body h3 {
  font-size: 1.15rem;
  font-weight: 700;
  color: #1e293b;
  margin: 0;
}

.home-cat-body p {
  font-size: 0.875rem;
  color: #64748b;
  line-height: 1.6;
  margin: 0;
  flex: 1;
}

.home-cat-link {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: #FF6600;
  margin-top: 0.75rem;
  letter-spacing: 0.2px;
  transition: gap 0.2s ease;
}
.home-cat-card:hover .home-cat-link {
  gap: 0.55rem;
}

/* ── Featured Products ───────────────────────────────────────── */

.home-featured {
  background: #f8fafc;
  padding: 4rem 2rem;
}

.home-featured-grid {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1.5rem;
}

.home-prod-card {
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid #e2e8f0;
  text-decoration: none;
  color: inherit;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  display: flex;
  flex-direction: column;
}
.home-prod-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.1);
}

.home-prod-img-wrap {
  position: relative;
  height: 200px;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.home-prod-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.home-prod-card:hover .home-prod-img {
  transform: scale(1.05);
}

.home-prod-badge {
  position: absolute;
  top: 0.75rem;
  right: 0.75rem;
  background: #dcfce7;
  color: #166534;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  border-radius: 20px;
  letter-spacing: 0.3px;
}

.home-prod-info {
  padding: 1rem 1.25rem 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.home-prod-info h4 {
  font-size: 0.95rem;
  font-weight: 600;
  color: #1e293b;
  margin: 0;
}

.home-prod-price {
  font-size: 1.1rem;
  font-weight: 800;
  color: #FF6600;
}

/* ── Trust Section ───────────────────────────────────────────── */

.trust-section {
  background: linear-gradient(135deg, #FFF8F2 0%, #FAFAFC 100%);
  padding: 5rem 2rem;
  border-top: 1px solid #F0E6DF;
}

.trust-inner {
  display: flex;
  justify-content: center;
  gap: 2rem;
  max-width: 1100px;
  margin: 0 auto;
  flex-wrap: wrap;
}

.trust-card {
  flex: 1;
  min-width: 240px;
  max-width: 320px;
  text-align: center;
  padding: 2.5rem 1.75rem;
  border-radius: 20px;
  background: #fff;
  border: 1px solid #FFE6D5;
  box-shadow: 0 4px 24px rgba(255, 102, 0, 0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.trust-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 48px rgba(255, 102, 0, 0.12);
}

.trust-icon-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 68px;
  height: 68px;
  border-radius: 20px;
  background: linear-gradient(135deg, #FFF0E6, #FFE0CC);
  color: #FF6600;
  margin-bottom: 1.25rem;
  transition: background 0.25s ease;
}
.trust-card:hover .trust-icon-wrap {
  background: linear-gradient(135deg, #FFE0CC, #FFC499);
}

.trust-card h4 {
  font-size: 1rem;
  font-weight: 700;
  color: #1e293b;
  margin: 0 0 0.5rem;
  letter-spacing: -0.2px;
}

.trust-card p {
  font-size: 0.875rem;
  color: #64748b;
  line-height: 1.65;
  margin: 0;
}

/* ── RTL overrides ───────────────────────────────────────────── */

[dir="rtl"] .hero-overlay {
  background: linear-gradient(
    to left,
    rgba(6, 22, 58, 0.82) 0%,
    rgba(6, 22, 58, 0.55) 50%,
    rgba(6, 22, 58, 0.25) 100%
  );
}

[dir="rtl"] .hero-content {
  padding: 3rem 5rem 3rem 3rem;
  align-items: flex-end;
  text-align: right;
}

[dir="rtl"] .hero-arrow--prev { left: auto; right: 1.5rem; }
[dir="rtl"] .hero-arrow--next { right: auto; left: 1.5rem; }

[dir="rtl"] .stat-item {
  border-right: none;
  border-left: 1px solid rgba(255, 255, 255, 0.1);
}
[dir="rtl"] .stat-item:last-child { border-left: none; }

/* ── Responsive ─────────────────────────────────────────────── */

@media (max-width: 768px) {
  .hero-slider { height: 420px; }

  .hero-content {
    padding: 2rem 1.5rem;
    max-width: 100%;
  }

  .hero-title { font-size: 1.6rem; }
  .hero-subtitle { font-size: 0.9rem; }

  .hero-arrow { display: none; }

  .stats-bar { gap: 0; }
  .stat-item {
    padding: 0.75rem 1.25rem;
    border-right: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    width: 50%;
  }

  .home-cat-grid { grid-template-columns: 1fr; }
  .home-featured-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 480px) {
  .home-featured-grid { grid-template-columns: 1fr; }
  .trust-inner { flex-direction: column; align-items: center; }
}
</file>

